# ── 必填 ────────────────────────────────────────────────────────────────
# Neon 連線字串（建議用 pooled 版本，host 含 -pooler）
# Neon 控制台 → Project → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 登入密碼（單一密碼，自用設計；不含使用者註冊）
APP_PASSWORD="change-me"

# 簽發 session cookie 用的金鑰，至少 32 字元隨機字串
# 產生方式：openssl rand -base64 48
AUTH_SECRET="change-me-too"

# ── 選填 ────────────────────────────────────────────────────────────────
# 顯示在登入頁與側邊欄的應用程式名稱
NEXT_PUBLIC_APP_NAME="MarkNote"

# Session 有效天數（預設 7）
SESSION_MAX_AGE_DAYS=7

# cookie 安全性：auto（預設，production 視為 https）| true | false
# COOKIE_SECURE=auto

# 閱讀模式允許内嵌 iframe 的網域白名單（逗號分隔）
# 預設已包含 YouTube / Vimeo / Bilibili；留空字串可完全停用 iframe 内嵌
# EMBED_ALLOWLIST="www.youtube.com,youtube-nocookie.com,player.vimeo.com,player.bilibili.com"

# ── 檔案庫（Neon Object Storage，S3 相容；留空則停用檔案庫）─────────────
# Neon Console → Storage 取得的端點與金鑰
# AWS_ENDPOINT_URL_S3="https://<你的 Neon 儲存端點>"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="ap-southeast-1"
# STORAGE_BUCKET="marknote-files"
# 單檔上傳上限（MiB，預設 200，最大 5120）
# STORAGE_MAX_UPLOAD_MB=200
# npm run storage:init 設定 CORS 時允許的來源（逗號分隔）
# APP_ORIGIN="http://localhost:3000"

# 開發／測試用：把 Neon HTTP 查詢導向相容端點（例如 dev/shim 的本地代理）
# 正式環境請留空
# NEON_FETCH_ENDPOINT="http://127.0.0.1:5599/sql"
